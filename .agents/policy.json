{
  "$comment": "Limits every agent task inherits (ADR-0032). Only people change this file: .agents/ is itself protected.",
  "defaultHarness": "claude",
  "branchPrefix": "agent/",
  "maxChangedLines": 300,
  "evidenceMaxLines": 200,
  "timeoutMinutes": 30,
  "labels": {
    "$comment": "Label names the issue runner owns (spec 020, REQ-ISS-002), by role. Rename a value to use your own label.",
    "needs-detail": "needs-detail",
    "approval-needed": "approval-needed",
    "human-decision-needed": "human-decision-needed",
    "review-needed": "review-needed",
    "good-to-merge": "good-to-merge",
    "running": "agent:running",
    "failed": "agent:failed"
  },
  "issues": {
    "$comment": "Issue-driven tasks (spec 020, ADR-0037). modelFor: collaborators | anyone. autonomy.simple: auto | plan-approve.",
    "applyRewrite": false,
    "autonomy": {
      "simple": "plan-approve"
    },
    "modelFor": "collaborators",
    "requireTests": true,
    "complexWhen": {
      "maxPaths": 5,
      "keywords": ["migration", "auth", "payment", "package.json", "Cargo.toml", "dependency"]
    },
    "uiGlobs": [],
    "screenshotCommand": "",
    "ciFix": {
      "enabled": false,
      "workflows": ["CI"],
      "maxAttempts": 1
    }
  },
  "protected": [
    "AGENTS.md",
    "CLAUDE.md",
    ".agents/",
    ".gemini/",
    ".github/",
    ".githooks/",
    ".cargo/",
    "**/package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "SECURITY.md",
    "CHANGELOG.md",
    "tooling/release/",
    "tooling/entrypoints.test.mjs",
    "tooling/file-size.test.mjs",
    "tooling/supply-chain/",
    "**/Cargo.toml",
    "Cargo.lock",
    "**/*.gradle.kts",
    "apps/ios/project.yml",
    "apps/ios/TranVotingDemo.xcodeproj/",
    "docs/adr/",
    "docs/reports/",
    "**/generated/",
    "**/Generated/",
    "DESIGN.md",
    "tooling/agents/",
    "vitest.config.ts",
    "tooling/metrics/budgets.json",
    "packages/core-ts/stryker.config.json"
  ],
  "signals": {
    "untranslated-strings": {
      "$comment": "Keys that are meant to read the same in every language.",
      "allow": ["common.brand", "shell.header"]
    }
  }
}
