# The build context of apps/api/Dockerfile is the repository root, so this is the file that applies
# (REQ-DEP-002). An allow-list: ignore everything, re-include only what `cargo build -p api` reads.
*
!Cargo.toml
!Cargo.lock
!crates/
!apps/api/
!locales/

# Never, even inside an allowed folder: build output, tests, local data, environments and keys.
**/target/
**/node_modules/
**/tests/
**/data/
**/.env*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/*.mobileprovision
**/.git
