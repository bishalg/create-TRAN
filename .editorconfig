root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.rs]
indent_size = 4

# Store listing text, generated by `pnpm tokens:sync` (REQ-MOB-011): fastlane `supply` uploads it
# verbatim, so a final newline would become part of the title or description.
[apps/*/fastlane/metadata/**.txt]
insert_final_newline = false
