# Copy to repo root `.env` (and optionally `apps/web/.env.local` for Vite).
# Never commit real secrets.

# ── Web (Vite) ─────────────────────────────────────────────────────────────
# Read by apps/web via import.meta.env.VITE_TRAN_API_URL
VITE_TRAN_API_URL=http://127.0.0.1:3001

# ── Axum API (apps/api) ────────────────────────────────────────────────────
RUST_LOG=info,tower_http=info
HOST=127.0.0.1
PORT=3001

# Optional: bind all interfaces in Docker (uncomment if needed)
# HOST=0.0.0.0
