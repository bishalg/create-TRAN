# Copy to repo root `.env` (and optionally `apps/web/.env.local` for Vite).
# Never commit real secrets.

# ── Web (Vite) ─────────────────────────────────────────────────────────────
# Read by apps/web via import.meta.env.VITE_TRAN_API_URL
VITE_TRAN_API_URL=http://127.0.0.1:3001

# ── Axum API (apps/api) ────────────────────────────────────────────────────
RUST_LOG=info,tower_http=info
HOST=127.0.0.1
PORT=3001
# development | test honour X-Debug-Country; any other value (e.g. production) ignores it, and also
# marks the refresh cookie Secure and sends HSTS.
APP_ENV=development
# Browser origins allowed to call the API with credentials (CORS and the auth Origin check), comma
# separated and exact, e.g. https://app.example.com. Empty: the local dev origins
# (http://localhost:3000, http://127.0.0.1:3000, http://localhost:8081) in development and test,
# no origin anywhere else.
CORS_ALLOWED_ORIGINS=

# Optional: bind all interfaces in Docker (uncomment if needed)
# HOST=0.0.0.0
