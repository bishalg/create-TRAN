# Copy to repo root `.env` (and optionally `apps/web/.env.local` for Vite).
# Never commit real secrets.

# ── Web (Vite) ─────────────────────────────────────────────────────────────
# Read by apps/web via import.meta.env.VITE_TRAN_API_URL
VITE_TRAN_API_URL=http://127.0.0.1:3001

# ── Axum API (apps/api) ────────────────────────────────────────────────────
RUST_LOG=info,tower_http=info
HOST=127.0.0.1
PORT=3001
# development | test honour X-Debug-Country; any other value (e.g. production) ignores it, and also
# marks the refresh cookie Secure and sends HSTS.
APP_ENV=development
# Browser origins allowed to call the API with credentials (CORS and the auth Origin check), comma
# separated and exact, e.g. https://app.example.com. Empty: the local dev origins
# (http://localhost:3000, http://127.0.0.1:3000, http://localhost:8081) in development and test,
# no origin anywhere else.
CORS_ALLOWED_ORIGINS=
# Database URL (spec 030, docs/PERSISTENCE.md): sqlite:<path> or sqlite::memory:. Unset: data/api.sqlite3
# under the working directory. In-memory databases are used in tests.
DATABASE_URL=
# Whether the server applies pending migrations at start-up: true or false (spec 030, REQ-DB-003).
# Unset: true in development and test, false anywhere else (production runs `api migrate` as its own step).
MIGRATE_ON_START=
# Trusted reverse proxies for rate limiting and client IP extraction (spec 031, docs/RATE_LIMITING.md).
# Comma-separated list of CIDR blocks or IP addresses (e.g. 127.0.0.1/32, 10.0.0.0/8).
# Unset or empty: trust nobody, count requests by direct peer address.
TRUSTED_PROXIES=
# Rate limits override per route class (spec 031, REQ-RL-001): <sustained_per_minute>[/<burst>].
# Unset: uses canonical defaults from crates/rust-core/src/rate.rs (auth: 10/5, write: 60/20, read: 300/60).
RATE_LIMIT_AUTH=
RATE_LIMIT_WRITE=
RATE_LIMIT_READ=
# Ceiling of in-flight requests for load shedding (spec 031, REQ-RL-007). Unset: 1024.
RATE_MAX_IN_FLIGHT=
# Observability: private Prometheus metrics listener address (spec 023, REQ-OBS-006).
# Unset or empty: 127.0.0.1:9090; set to "off" to disable the private metrics listener.
METRICS_ADDR=
# Observability: shutdown draining grace period in milliseconds (spec 023, REQ-OBS-008).
# Unset or empty: 15000 (15 seconds).
SHUTDOWN_GRACE_MS=

# ── Push delivery from the API (apps/api, docs/PUSH.md, docs/CREDENTIALS.md) ─
# Each provider is on only when all its variables are set; with none set it is off and the API runs
# (ADR-0046). Half set, or a key that does not parse, stops start-up naming the variable.
# APNs auth key id (10 characters; Certificates, Identifiers & Profiles → Keys). No default.
APNS_KEY_ID=
# Apple Developer team id that owns the key (10 characters). No default.
APNS_TEAM_ID=
# Content of the APNs auth key's .p8 file (newlines kept, or written as \n). Never commit the file.
APNS_KEY_P8=
# The iOS app's bundle id, sent as apns-topic. No default: it must name your app.
APNS_TOPIC=
# Firebase service-account key allowed to send (Cloud Messaging), the whole JSON. No default.
FCM_SERVICE_ACCOUNT_JSON=
# Only for the switched-off live tests (apps/api/tests/push_live_test.rs): a real device's token, from
# a development build for APNs (sandbox), and from any build for FCM.
APNS_TEST_DEVICE_TOKEN=
# FCM registration token of a real Android device or emulator with Google Play services.
FCM_TEST_DEVICE_TOKEN=

# ── App versions the API serves (apps/api, spec 028, docs/API_VERSIONING.md) ──
# Per platform, because the stores approve on different days; empty means no threshold. A value is a
# version like 1.4.0; anything else stops start-up naming the variable. Raising one needs a restart,
# not a release. Below the minimum every product route answers 426 client.upgrade_required and the
# app shows a blocking update screen; prefer the recommended version, which only adds
# `X-Tran-Update: recommended` so the app offers a prompt that can be dismissed.
CLIENT_MIN_VERSION_IOS=
CLIENT_RECOMMENDED_VERSION_IOS=
CLIENT_MIN_VERSION_ANDROID=
CLIENT_RECOMMENDED_VERSION_ANDROID=
CLIENT_MIN_VERSION_WEB=
CLIENT_RECOMMENDED_VERSION_WEB=

# Optional: bind all interfaces in Docker (uncomment if needed)
# HOST=0.0.0.0

# ── Android app (apps/android) ─────────────────────────────────────────────
# API base URL compiled into the Android build (REQ-NAT-011); `-PtranApiBaseUrl=…` wins. Empty: the
# emulator host (http://10.0.2.2:3001) in debug, the HTTPS placeholder in release.
TRAN_API_BASE_URL=
# Store page the "Update" button opens when the API asks for a newer version (spec 028, REQ-VER-011),
# compiled into the build; https only. Empty: the placeholder https://tran.example/android.
TRAN_ANDROID_STORE_URL=

# ── Mobile release (fastlane) ──────────────────────────────────────────────
# Spec 025, docs/MOBILE_RELEASE.md. Set these in CI secrets (same names) or an untracked .env, never here.
# `pnpm ios:lane doctor` / `pnpm android:lane doctor` lists which are missing, without printing values.
# iOS bundle id; empty: the template placeholder com.tran.voting, which the scaffolder rewrites.
TRAN_IOS_BUNDLE_ID=
# Apple Developer team id (10 characters, Membership details). No default.
TRAN_APPLE_TEAM_ID=
# App Store Connect app id (the numeric Apple ID on the app's App Information page). No default.
TRAN_ASC_APP_ID=
# App Store Connect API key id (Users and Access → Integrations, App Manager role). No default.
TRAN_ASC_KEY_ID=
# App Store Connect API issuer id (same page). No default.
TRAN_ASC_ISSUER_ID=
# Content of the API key's .p8 file (newlines kept, or written as \n). Never commit the file. No default.
TRAN_ASC_KEY_P8=
# Android application id; empty: the template placeholder com.tran.voting, which the scaffolder rewrites.
TRAN_ANDROID_APPLICATION_ID=
# Android upload keystore, base64-encoded (`base64 -i upload.jks`); Gradle signs the release build only
# when this and the three below are set. Never commit the .jks. No default.
TRAN_ANDROID_KEYSTORE_BASE64=
# Password of the upload keystore. No default.
TRAN_ANDROID_KEYSTORE_PASSWORD=
# Alias of the upload key inside the keystore. No default.
TRAN_ANDROID_KEY_ALIAS=
# Password of the upload key. No default.
TRAN_ANDROID_KEY_PASSWORD=
# Google Play service-account key, the whole JSON (release permission in the Play Console). No default.
TRAN_PLAY_SERVICE_ACCOUNT_JSON=

# ── Android push (FCM, spec 027) ───────────────────────────────────────────
# The Firebase project's public values, compiled into the Android build (ADR-0044 decision 9: no
# google-services.json). All four, or push stays off: no "Notify me" control, Firebase never starts.
# Firebase console → Project settings → General. Project id. No default.
TRAN_FCM_PROJECT_ID=
# The Android app's "App ID" (1:<number>:android:<hex>). No default.
TRAN_FCM_APP_ID=
# The Web API key: a public identifier of the project, not a secret, though Google names it a key. No default.
TRAN_FCM_API_KEY=
# Project number (Cloud Messaging tab: Sender ID). No default.
TRAN_FCM_SENDER_ID=

# ── iOS push (APNs, spec 027) ──────────────────────────────────────────────
# Not read from the environment: an Xcode build setting, passed on the command line
# (`xcodebuild … TRAN_PUSH_ENABLED=YES DEVELOPMENT_TEAM=$TRAN_APPLE_TEAM_ID`). YES adds the
# aps-environment entitlement, which needs TRAN_APPLE_TEAM_ID's App ID to have the Push Notifications
# capability. Empty or NO (the default in apps/ios/project.yml): push unavailable, no "Notify me".
TRAN_PUSH_ENABLED=
