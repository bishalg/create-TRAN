# Copy to repo root `.env` (and optionally `apps/web/.env.local` for Vite).
# Never commit real secrets.

# ── Web (Vite) ─────────────────────────────────────────────────────────────
# Read by apps/web via import.meta.env.VITE_TRAN_API_URL
VITE_TRAN_API_URL=http://127.0.0.1:3001

# ── Axum API (apps/api) ────────────────────────────────────────────────────
RUST_LOG=info,tower_http=info
HOST=127.0.0.1
PORT=3001
# development | test honour X-Debug-Country; any other value (e.g. production) ignores it, and also
# marks the refresh cookie Secure and sends HSTS.
APP_ENV=development
# Browser origins allowed to call the API with credentials (CORS and the auth Origin check), comma
# separated and exact, e.g. https://app.example.com. Empty: the local dev origins
# (http://localhost:3000, http://127.0.0.1:3000, http://localhost:8081) in development and test,
# no origin anywhere else.
CORS_ALLOWED_ORIGINS=

# Optional: bind all interfaces in Docker (uncomment if needed)
# HOST=0.0.0.0

# ── Android app (apps/android) ─────────────────────────────────────────────
# API base URL compiled into the Android build (REQ-NAT-011); `-PtranApiBaseUrl=…` wins. Empty: the
# emulator host (http://10.0.2.2:3001) in debug, the HTTPS placeholder in release.
TRAN_API_BASE_URL=

# ── Mobile release (fastlane) ──────────────────────────────────────────────
# Spec 025, docs/MOBILE_RELEASE.md. Set these in CI secrets (same names) or an untracked .env, never here.
# `pnpm ios:lane doctor` / `pnpm android:lane doctor` lists which are missing, without printing values.
# iOS bundle id; empty: the template placeholder com.tran.voting, which the scaffolder rewrites.
TRAN_IOS_BUNDLE_ID=
# Apple Developer team id (10 characters, Membership details). No default.
TRAN_APPLE_TEAM_ID=
# App Store Connect app id (the numeric Apple ID on the app's App Information page). No default.
TRAN_ASC_APP_ID=
# App Store Connect API key id (Users and Access → Integrations, App Manager role). No default.
TRAN_ASC_KEY_ID=
# App Store Connect API issuer id (same page). No default.
TRAN_ASC_ISSUER_ID=
# Content of the API key's .p8 file (newlines kept, or written as \n). Never commit the file. No default.
TRAN_ASC_KEY_P8=
# Android application id; empty: the template placeholder com.tran.voting, which the scaffolder rewrites.
TRAN_ANDROID_APPLICATION_ID=
# Android upload keystore, base64-encoded (`base64 -i upload.jks`); Gradle signs the release build only
# when this and the three below are set. Never commit the .jks. No default.
TRAN_ANDROID_KEYSTORE_BASE64=
# Password of the upload keystore. No default.
TRAN_ANDROID_KEYSTORE_PASSWORD=
# Alias of the upload key inside the keystore. No default.
TRAN_ANDROID_KEY_ALIAS=
# Password of the upload key. No default.
TRAN_ANDROID_KEY_PASSWORD=
# Google Play service-account key, the whole JSON (release permission in the Play Console). No default.
TRAN_PLAY_SERVICE_ACCOUNT_JSON=
