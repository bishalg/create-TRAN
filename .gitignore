# Dependencies (pnpm creates root + per-package symlink trees — all ignored)
node_modules/
.pnpm-store/
.npm/
.yarn/
.pnp.*

# Build artifacts
dist/
build/
.output/
.vinxi/
.tanstack/
.next/
out/
.turbo/
.nx/cache/
.nx/workspace-data/
*.tsbuildinfo

# Rust / Cargo build output (Cargo.lock is committed for reproducible apps)
target/
**/*.rs.bk

# Android / Gradle (apps/android)
.gradle/
.kotlin/
local.properties

# Swift / Xcode (apps/ios)
.build/
DerivedData/
xcuserdata/
*.xcuserstate
apps/ios/RustLib/**/*
!apps/ios/RustLib/active.xcconfig

# Expo & React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
apps/native/android/
apps/native/ios/

# macOS & OS files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# Environment variables & secrets
.env
.env.*
!.env.example

# Logs & coverage
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# IDE / Editor
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Misc
*.local
.cache/
tmp/
temp/

# E2E / BDD generated output
e2e/.features-gen/
e2e/test-results/
e2e/playwright-report/
coverage/
