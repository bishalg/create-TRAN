<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- REQ-NAT-011: the voter dashboard confirms verdicts with the Axum API; the device check needs no network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hear when the network returns, so the offline banner can recover at once (REQ-ERR-013). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REQ-PRV-006: "Use my location" reads one approximate fix, while in use, to fill the country.
         Coarse only: never fine or background location (spec 026, ADR-0043). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- REQ-SEC-020: the session vault never leaves the device. No backup at all, and on API 31+, where
         device-to-device transfer ignores allowBackup, explicit rules exclude the vault too; restored
         ciphertext would be useless anyway, since its Keystore key is not backed up. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/common_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
