<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- REQ-NAT-011: the voter dashboard confirms verdicts with the Axum API; the device check needs no network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Hear when the network returns, so the offline banner can recover at once (REQ-ERR-013). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- REQ-PRV-006: "Use my location" reads one approximate fix, while in use, to fill the country.
         Coarse only: never fine or background location (spec 026, ADR-0043). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- REQ-PSH-008: "Notify me when I can vote" asks for it in context, after priming, never at launch
         or sign-in (spec 027). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- REQ-SEC-020: the session vault never leaves the device. No backup at all, and since device-to-device
         transfer ignores allowBackup, explicit rules exclude the vault too; restored ciphertext would be
         useless anyway, since its Keystore key is not backed up. The data-extraction rules cover every
         supported level (minSdk 33, ADR-0045), so no older full-backup rules are needed. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/common_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Spec 027, ADR-0044 decision 9: FCM, started only by SystemPushGateway from the build's values.
             Firebase's auto-init provider is removed and token auto-init is off, so a build without the
             values never starts Firebase, and a build with them asks for a token only after the person
             has granted notifications and signed in. Delivery metrics are not exported. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />
        <!-- In the background FCM posts the notification itself, on the app's own channel
             (SystemPushGateway.CHANNEL_ID), not its fallback channel. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="eligibility_reminders" />
        <!-- Token refresh and foreground messages, all handed to the push gateway. -->
        <service
            android:name=".push.TranMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
