        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैश्विक मतदान आयु नियम rust-core समानता फ़िक्स्चर द्वारा सत्यापित।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्वव्यापी मतदान उमेर नियमहरू rust-core समानता फिक्स्चरद्वारा प्रमाणित।"
          }
        }
      }
    },
