{
  "sourceLanguage": "en",
  "strings": {
    "auth.continueAsAuditor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue as Election Auditor"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनाव ऑडिटर के रूप में जारी रखें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्वाचन अडिटरको रूपमा जारी राख्नुहोस्"
          }
        }
      }
    },
    "auth.continueAsVoter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue as Citizen Voter"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नागरिक मतदाता के रूप में जारी रखें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नागरिक मतदाताको रूपमा जारी राख्नुहोस्"
          }
        }
      }
    },
    "auth.signOutConfirm.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll return to role selection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप भूमिका चयन पर लौट जाएँगे।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं भूमिका छनोटमा फर्कनुहुनेछ।"
          }
        }
      }
    },
    "auth.signOutConfirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट करें?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट गर्ने?"
          }
        }
      }
    },
    "auth.welcome.subtitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select your role to continue into the application:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए अपनी भूमिका चुनें:"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी राख्न आफ्नो भूमिका छान्नुहोस्:"
          }
        }
      }
    },
    "auth.welcome.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to TRAN Voting"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN वोटिंग में आपका स्वागत है"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN मतदानमा स्वागत छ"
          }
        }
      }
    }
  },
  "version": "1.0"
}
