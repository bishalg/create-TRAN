{
  "sourceLanguage": "en",
  "strings": {
    "eligibility.age.example": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. 21"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे 21"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जस्तै २१"
          }
        }
      }
    },
    "eligibility.age.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your age"
          }
        },
        "hi": {
