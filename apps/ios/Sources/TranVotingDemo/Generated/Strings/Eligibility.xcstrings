{
  "sourceLanguage": "en",
  "strings": {
    "eligibility.age.example": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. 21"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे 21"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जस्तै २१"
          }
        }
      }
    },
    "eligibility.age.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your age"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी आयु"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको उमेर"
          }
        }
      }
    },
    "eligibility.age.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter age"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयु दर्ज करें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उमेर लेख्नुहोस्"
          }
        }
      }
    },
    "eligibility.checkOffline": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check offline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन जाँचें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अफलाइन जाँच"
          }
        }
      }
    },
    "eligibility.country.example": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. NP"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसे NP"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जस्तै NP"
          }
        }
      }
    },
    "eligibility.country.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters, like US, NP or BR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो अक्षर, जैसे US, NP या BR।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "दुई अक्षर, जस्तै US, NP वा BR।"
          }
        }
      }
    },
    "eligibility.country.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country code"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देश कोड"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "देश कोड"
          }
        }
      }
    },
    "eligibility.country.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो अक्षर"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "दुई अक्षर"
          }
        }
      }
    },
    "eligibility.country.serverHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sent to the server as the X-Debug-Country header (development only)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर को X-Debug-Country हेडर के रूप में भेजा जाता है (केवल विकास के लिए)।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्भरमा X-Debug-Country हेडरको रूपमा पठाइन्छ (विकासका लागि मात्र)।"
          }
        }
      }
    },
    "eligibility.form.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eligibility check"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्रता जाँच"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "योग्यता जाँच"
          }
        }
      }
    },
    "eligibility.location.primingBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN can read your approximate location once to find your country, so it picks the right voting age. Your location is not kept or sent anywhere. This is optional: you can type the country yourself."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN सही मतदान आयु चुनने के लिए आपका अनुमानित स्थान एक बार पढ़कर आपका देश पता करता है। आपका स्थान न रखा जाता है, न कहीं भेजा जाता है। यह वैकल्पिक है: आप देश खुद भी लिख सकते हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सही मतदान उमेर छान्न TRAN ले तपाईंको अनुमानित स्थान एक पटक पढेर तपाईंको देश पत्ता लगाउँछ। तपाईंको स्थान राखिँदैन, कतै पठाइँदैन। यो ऐच्छिक हो: तपाईं देश आफैँ लेख्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "eligibility.location.primingTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in your country from your location?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने स्थान से देश भरें?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको स्थानबाट देश भर्ने?"
          }
        }
      }
    },
    "eligibility.location.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN uses your approximate location once to find your country and pick the right voting age. It is optional; you can type the country instead."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN आपका देश पता करने और सही मतदान आयु चुनने के लिए आपके अनुमानित स्थान का एक बार उपयोग करता है। यह वैकल्पिक है; आप देश खुद लिख सकते हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN ले तपाईंको देश पत्ता लगाउन र सही मतदान उमेर छान्न तपाईंको अनुमानित स्थान एक पटक प्रयोग गर्छ। यो ऐच्छिक हो; तपाईं देश आफैँ लेख्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "eligibility.location.settingsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is off for TRAN. Type your country, or turn location on in Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN के लिए स्थान बंद है। अपना देश लिखें, या सेटिंग्स में स्थान चालू करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN का लागि स्थान बन्द छ। आफ्नो देश लेख्नुहोस्, वा सेटिङमा स्थान खोल्नुहोस्।"
          }
        }
      }
    },
    "eligibility.location.use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use my location"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरा स्थान इस्तेमाल करें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरो स्थान प्रयोग गर्नुहोस्"
          }
        }
      }
    },
    "eligibility.mode.device": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this device"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसी डिवाइस पर"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यही उपकरणमा"
          }
        }
      }
    },
    "eligibility.mode.deviceHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instant, works offline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत, ऑफ़लाइन भी चलता है"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरुन्त, अफलाइन पनि चल्छ"
          }
        }
      }
    },
    "eligibility.mode.legend": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where should the check run?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच कहाँ चलानी है?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँच कहाँ चलाउने?"
          }
        }
      }
    },
    "eligibility.mode.server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the server"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से पूछें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्भरलाई सोध्नुहोस्"
          }
        }
      }
    },
    "eligibility.mode.serverHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rust rules behind the API"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API के पीछे Rust नियम"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "API पछाडिको Rust नियम"
          }
        }
      }
    },
    "eligibility.notification.reached.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open TRAN to check your eligibility again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पात्रता फिर से जाँचने के लिए TRAN खोलें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आफ्नो योग्यता फेरि जाँच्न TRAN खोल्नुहोस्।"
          }
        }
      }
    },
    "eligibility.notification.reached.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can vote now"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप मतदान कर सकते हैं"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अब तपाईं मतदान गर्न सक्नुहुन्छ"
          }
        }
      }
    },
    "eligibility.notify.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify me when I can vote"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मतदान कर सकने पर मुझे सूचित करें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मतदान गर्न सक्ने भएपछि मलाई सूचना दिनुहोस्"
          }
        }
      }
    },
    "eligibility.notify.primingBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN can send you one notification when you become old enough to vote. It says only that you can vote now; open TRAN to see more. This is optional, and you can turn it off at any time in Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप मतदान की आयु के हो जाएँगे, TRAN आपको एक सूचना भेज सकता है। उसमें केवल यह लिखा होगा कि अब आप मतदान कर सकते हैं; अधिक जानने के लिए TRAN खोलें। यह वैकल्पिक है, और आप इसे कभी भी सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं मतदान गर्ने उमेर पुगेपछि TRAN ले तपाईंलाई एउटा सूचना पठाउन सक्छ। त्यसमा अब तपाईं मतदान गर्न सक्नुहुन्छ भन्ने मात्र हुन्छ; थप हेर्न TRAN खोल्नुहोस्। यो ऐच्छिक हो, र तपाईं यसलाई जुनसुकै बेला सेटिङमा बन्द गर्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "eligibility.notify.primingTitle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get one notification when you can vote?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मतदान कर सकने पर एक सूचना पाएँ?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मतदान गर्न सक्ने भएपछि एउटा सूचना पाउने?"
          }
        }
      }
    },
    "eligibility.notify.purpose": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN sends a notification only when you become old enough to vote, never anything about you. It is optional."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN केवल तब सूचना भेजता है जब आप मतदान की आयु के हो जाते हैं, आपके बारे में कभी कुछ नहीं। यह वैकल्पिक है।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN ले तपाईं मतदान गर्ने उमेर पुगेपछि मात्र सूचना पठाउँछ, तपाईंबारे कहिल्यै केही होइन। यो ऐच्छिक हो।"
          }
        }
      }
    },
    "eligibility.notify.received": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN has news about your eligibility. Check again to see it."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पात्रता के बारे में TRAN के पास नई जानकारी है। देखने के लिए फिर से जाँचें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको योग्यताबारे TRAN सँग नयाँ जानकारी छ। हेर्न फेरि जाँच्नुहोस्।"
          }
        }
      }
    },
    "eligibility.notify.settingsNote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off for TRAN. Turn them on in Settings to hear when you can vote."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN के लिए सूचनाएँ बंद हैं। मतदान कर सकने पर पता चलने के लिए सेटिंग्स में सूचनाएँ चालू करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "TRAN का लागि सूचनाहरू बन्द छन्। मतदान गर्न सक्ने भएपछि थाहा पाउन सेटिङमा सूचनाहरू खोल्नुहोस्।"
          }
        }
      }
    },
    "eligibility.offlineNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "API unreachable — using offline rules mirrored from Rust Core."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "API उपलब्ध नहीं — Rust Core से मेल खाते ऑफ़लाइन नियम।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "API उपलब्ध छैन — Rust Core सँग मिल्दो अफलाइन नियम।"
          }
        }
      }
    },
    "eligibility.result.country": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देश"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "देश"
          }
        }
      }
    },
    "eligibility.result.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "नतिजा"
          }
        }
      }
    },
    "eligibility.result.minimumAge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum age"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम आयु"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम उमेर"
          }
        }
      }
    },
    "eligibility.result.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Check offline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन जाँच दबाएँ"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अफलाइन जाँच थिच्नुहोस्"
          }
        }
      }
    },
    "eligibility.result.reasonBelow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age %1$@ is below the minimum voting age of %2$@ in %3$@."
          }
        },
        "hi": {
          "stringUnit": {
