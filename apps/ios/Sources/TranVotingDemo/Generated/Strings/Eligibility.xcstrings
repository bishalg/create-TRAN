    },
    "eligibility.result.minimumAge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minimum age"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम आयु"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम उमेर"
          }
        }
      }
    },
    "eligibility.result.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Check offline"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन जाँच दबाएँ"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अफलाइन जाँच थिच्नुहोस्"
          }
        }
      }
    },
    "eligibility.result.reasonBelow": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age %1$@ is below the minimum voting age of %2$@ in %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयु %1$@ न्यूनतम मतदान आयु %2$@ से कम है (%3$@)।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उमेर %1$@ न्यूनतम मतदान उमेर %2$@ भन्दा कम छ (%3$@)।"
          }
        }
      }
    },
    "eligibility.result.reasonMeets": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age %1$@ meets the minimum voting age of %2$@ in %3$@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयु %1$@ न्यूनतम मतदान आयु %2$@ को पूरा करती है (%3$@)।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उमेर %1$@ ले न्यूनतम मतदान उमेर %2$@ पूरा गर्छ (%3$@)।"
          }
        }
      }
    },
    "eligibility.result.sourceDevice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked on this device"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसी डिवाइस पर जाँच की गई"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यही उपकरणमा जाँच गरियो"
          }
        }
      }
    },
    "eligibility.result.sourceServer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked by the server"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर द्वारा जाँच की गई"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्भरबाट जाँच गरियो"
          }
        }
