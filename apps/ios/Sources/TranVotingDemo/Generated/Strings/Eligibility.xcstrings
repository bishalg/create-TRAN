            "value": "जस्तै NP"
          }
        }
      }
    },
    "eligibility.country.hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters, like US, NP or BR."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो अक्षर, जैसे US, NP या BR।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "दुई अक्षर, जस्तै US, NP वा BR।"
          }
        }
      }
    },
    "eligibility.country.label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country code"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देश कोड"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "देश कोड"
          }
        }
      }
    },
    "eligibility.country.placeholder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two letters"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दो अक्षर"
