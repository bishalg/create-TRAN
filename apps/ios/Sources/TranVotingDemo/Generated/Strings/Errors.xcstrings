{
  "sourceLanguage": "en",
  "strings": {
    "errors.ageAndCountry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter age and country"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयु और देश दर्ज करें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "उमेर र देश लेख्नुहोस्"
          }
        }
      }
    },
    "errors.ageInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid age"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान्य आयु दर्ज करें"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मान्य उमेर लेख्नुहोस्"
          }
        }
      }
    },
    "errors.ageOutOfRange": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a whole-number age between 0 and 150."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "0 से 150 के बीच पूरी संख्या में आयु दर्ज करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "० देखि १५० बीचको पूर्ण संख्या उमेर राख्नुहोस्।"
          }
        }
      }
    },
    "errors.birthdateInFuture": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Birthdate can't be in the future."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मतिथि भविष्य की नहीं हो सकती।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्ममिति भविष्यको हुन सक्दैन।"
          }
        }
      }
    },
    "errors.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changed while you were working on it. Refresh and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके काम करते समय यह बदल गया। रीफ़्रेश करके फिर से कोशिश करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं काम गर्दै गर्दा यो परिवर्तन भयो। रिफ्रेस गरेर फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "errors.countryInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country must be two letters"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देश दो अक्षरों का होना चाहिए"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "देश दुई अक्षरको हुनुपर्छ"
          }
        }
      }
    },
    "errors.dateInvalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a real date as YYYY-MM-DD."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "YYYY-MM-DD रूप में सही तारीख दर्ज करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "YYYY-MM-DD ढाँचामा सही मिति लेख्नुहोस्।"
          }
        }
      }
    },
    "errors.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to do that."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको यह करने की अनुमति नहीं है।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंलाई यो गर्ने अनुमति छैन।"
          }
        }
      }
    },
    "errors.notFound": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature isn't available on the server yet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सुविधा अभी सर्वर पर उपलब्ध नहीं है।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो सुविधा अहिले सर्भरमा उपलब्ध छैन।"
          }
        }
      }
    },
    "errors.rateLimited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests. Please wait a moment and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत अधिक अनुरोध। कृपया थोड़ी देर बाद फिर कोशिश करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "धेरै अनुरोधहरू भए। कृपया केही बेरपछि फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "errors.reference": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference: %1$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ: %1$@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सन्दर्भ: %1$@"
          }
        }
      }
    },
    "errors.renderFailed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen couldn't be shown"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह स्क्रीन नहीं दिखाई जा सकी"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो स्क्रिन देखाउन सकिएन"
          }
        }
      }
    },
    "errors.renderFailedBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something in the app broke. Reloading usually fixes it; your settings are kept."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में कुछ गड़बड़ हो गई। दोबारा लोड करने से आमतौर पर ठीक हो जाता है; आपकी सेटिंग्स सुरक्षित रहती हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपमा केही बिग्रियो। फेरि लोड गर्दा प्रायः ठीक हुन्छ; तपाईंका सेटिङहरू सुरक्षित रहन्छन्।"
          }
        }
      }
    },
    "errors.requestCancelled": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request was cancelled."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध रद्द कर दिया गया।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध रद्द गरियो।"
          }
        }
      }
    },
    "errors.requestMalformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app sent a request the server couldn't read. Please refresh and try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप ने ऐसा अनुरोध भेजा जिसे सर्वर पढ़ नहीं सका। कृपया रीफ़्रेश करके फिर कोशिश करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपले सर्भरले पढ्न नसक्ने अनुरोध पठायो। कृपया रिफ्रेस गरेर फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "errors.serverInternal": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong on our side. Your result was checked on this device instead."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमारी ओर से कुछ गड़बड़ हुई। आपका परिणाम इसी डिवाइस पर जाँचा गया।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हाम्रो तर्फबाट केही गडबड भयो। तपाईंको नतिजा यही उपकरणमा जाँचियो।"
          }
        }
      }
    },
    "errors.serverUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is temporarily unavailable — results are checked on this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर अस्थायी रूप से उपलब्ध नहीं है — परिणाम इसी डिवाइस पर जाँचे जा रहे हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्भर अस्थायी रूपमा उपलब्ध छैन — नतिजा यही उपकरणमा जाँचिँदैछ।"
          }
        }
      }
    },
    "errors.sessionExpired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सत्र समाप्त हो गया है"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको सत्र समाप्त भयो"
          }
        }
      }
    },
    "errors.sessionExpiredBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in again to continue. Anything you typed stays on this screen until you do."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए फिर से साइन इन करें। तब तक आपने जो लिखा है वह इसी स्क्रीन पर रहेगा।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी राख्न फेरि साइन इन गर्नुहोस्। त्यतिन्जेल तपाईंले लेखेको कुरा यही स्क्रिनमा रहन्छ।"
          }
        }
      }
    },
    "errors.timeout": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is taking too long — results are checked on this device."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर बहुत समय ले रहा है — परिणाम इसी डिवाइस पर जाँचे जा रहे हैं।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्भरले धेरै समय लिइरहेको छ — नतिजा यही उपकरणमा जाँचिँदैछ।"
          }
        }
      }
    },
    "errors.unexpected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong in the app. Please try again."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में कुछ गड़बड़ हुई। कृपया फिर कोशिश करें।"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपमा केही गडबड भयो। कृपया फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    }
  },
  "version": "1.0"
}
