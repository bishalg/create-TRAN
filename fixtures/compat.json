    },
    {
      "name": "above both",
      "client": "web/2.0.0",
      "minimum": "1.2.0",
      "recommended": "1.5.0",
      "standing": "supported"
    },
    {
      "name": "a pre-release of the minimum counts as the minimum",
      "client": "ios/1.2.0-beta.1",
      "minimum": "1.2.0",
      "recommended": null,
      "standing": "supported"
    },
    {
      "name": "an unknown client is served",
      "client": null,
      "minimum": "9.0.0",
      "recommended": "9.0.0",
      "standing": "supported"
    },
    {
      "name": "a malformed header is served",
      "client": "ios/latest",
      "minimum": "9.0.0",
      "recommended": null,
      "standing": "supported"
    }
  ],
  "updatePrompts": [
    {
      "name": "recommended and never dismissed",
      "standing": "update_recommended",
      "recommendedVersion": "1.5.0",
      "dismissedVersion": null,
      "show": true
    },
    {
      "name": "dismissed for this recommended version",
