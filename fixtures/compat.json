{
  "$comment": "API versioning and client compatibility (spec 028, ADR-0047) shared by Rust (crates/rust-core/tests/compat_fixtures.rs), UniFFI (crates/tran-uniffi/tests/compat_fixtures.rs), TypeScript (packages/core-ts/tests/compat.test.ts, packages/api/tests/compat.test.ts), iOS (CompatTests.swift) and Android (CompatTest.kt). Change a rule here first (red), then crates/rust-core/src/compat.rs, then `pnpm tokens:sync`. `clients`: how `X-Tran-Client` parses (`header: null` is no header; `version: null` is no version). `versions`: `order` is -1, 0 or 1 for a below, equal or above b; a part that is not a number counts as 0 (only thresholds are compared, and they are validated first). `standings`: `minimum`/`recommended` are the client's platform's thresholds (`null`: none). `updatePrompts`: whether the dismissible prompt shows. `wireEnums`: the fallback of every enum a client decodes; `wireEnumCases` pins decoding. `responsesFromTheFuture`: one answer per route as a newer server may send it (extra fields at every level, an unknown enum value where the route has one); every platform must decode each with its own schemas and read `expect` (dotted paths; `user.role` is the `role` inside `user`, `components.0` the first item). Routes that answer `204` have no body to decode and are not listed.",
  "basePath": "/api/v1",
  "healthPath": "/api/health",
  "headers": {
    "client": "X-Tran-Client",
    "update": "X-Tran-Update",
    "updateRecommended": "recommended",
    "recommendedVersion": "X-Tran-Recommended-Version"
  },
  "clients": [
    { "name": "iOS", "header": "ios/1.4.0", "platform": "ios", "version": "1.4.0" },
    { "name": "Android", "header": "android/1.4.0", "platform": "android", "version": "1.4.0" },
    { "name": "web", "header": "web/1.4.0", "platform": "web", "version": "1.4.0" },
    { "name": "two parts", "header": "web/2.0", "platform": "web", "version": "2.0" },
    { "name": "four parts", "header": "ios/1.4.0.7", "platform": "ios", "version": "1.4.0.7" },
    {
      "name": "pre-release",
      "header": "ios/1.4.0-beta.1",
      "platform": "ios",
      "version": "1.4.0-beta.1"
    },
    {
      "name": "build metadata",
      "header": "android/1.4.0+42",
      "platform": "android",
      "version": "1.4.0+42"
    },
    {
      "name": "surrounding spaces",
      "header": "  web/1.4.0 ",
      "platform": "web",
      "version": "1.4.0"
    },
    { "name": "no header", "header": null, "platform": "unknown", "version": null },
    { "name": "empty", "header": "", "platform": "unknown", "version": null },
    { "name": "no slash", "header": "ios", "platform": "unknown", "version": null },
    { "name": "no version", "header": "ios/", "platform": "unknown", "version": null },
    { "name": "unknown platform", "header": "watch/1.0.0", "platform": "unknown", "version": null },
    {
      "name": "platform in capitals",
      "header": "IOS/1.4.0",
      "platform": "unknown",
      "version": null
    },
    {
      "name": "the word unknown",
      "header": "unknown/1.0.0",
      "platform": "unknown",
      "version": null
    },
    { "name": "not a number", "header": "web/one", "platform": "unknown", "version": null },
    { "name": "empty part", "header": "web/1..0", "platform": "unknown", "version": null },
    { "name": "five parts", "header": "web/1.2.3.4.5", "platform": "unknown", "version": null },
    {
      "name": "a part too long",
      "header": "web/1234567890.0",
      "platform": "unknown",
      "version": null
    },
    { "name": "empty suffix", "header": "web/1.0.0-", "platform": "unknown", "version": null },
    { "name": "odd suffix", "header": "web/1.0.0-beta!", "platform": "unknown", "version": null },
    { "name": "a space inside", "header": "web/1.0 .0", "platform": "unknown", "version": null },
    { "name": "a second slash", "header": "web/1.0.0/x", "platform": "unknown", "version": null },
    {
      "name": "longer than 32 characters",
      "header": "web/1.0.0-aaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": "unknown",
      "version": null
    },
    {
      "name": "exactly 32 characters",
      "header": "web/1.0.0-aaaaaaaaaaaaaaaaaaaaaaaaaa",
      "platform": "web",
      "version": "1.0.0-aaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    {
      "name": "a log injection",
      "header": "web/1.0.0\nlevel=error",
      "platform": "unknown",
      "version": null
    }
  ],
  "formatted": [
    { "platform": "ios", "version": "1.4.0", "header": "ios/1.4.0" },
    { "platform": "android", "version": "2.0.0", "header": "android/2.0.0" },
