    { "a": "0.1.0", "b": "0.0.9", "order": 1 },
    { "a": "01.2", "b": "1.2", "order": 0 },
    { "a": "1.x", "b": "1.0", "order": 0 }
  ],
  "standings": [
    {
      "name": "no thresholds",
