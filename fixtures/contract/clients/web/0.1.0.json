        "access_token": "string",
        "token_type": "string",
        "expires_in": "number",
        "user.user_id": "string",
        "user.role": "string"
      }
    },
    {
      "name": "whoAmI",
      "method": "GET",
      "path": "/api/v1/auth/session",
