{
  "$comment": "The web client 0.1.0 as released: written by `pnpm release` from current.json (REQ-VER-003). Replayed by apps/api/tests/client_replay_test.rs until 0.1.0 is below the web minimum; then delete this file.",
  "platform": "web",
  "version": "0.1.0",
  "requests": [
    {
      "name": "getHealth",
      "method": "GET",
      "path": "/api/health",
      "headers": {
        "X-Tran-Client": "web/0.1.0"
      },
      "status": 200,
      "reads": {
        "report_id": "string",
        "timestamp": "string",
        "overall_status": "string",
        "components[].layer": "string",
        "components[].name": "string",
        "components[].version": "string",
        "components[].healthy": "boolean",
        "components[].uptime_seconds": "number"
      }
    },
    {
      "name": "getInfo",
      "method": "GET",
      "path": "/api/v1/tran/info",
      "headers": {
        "X-Tran-Client": "web/0.1.0"
      },
      "status": 200,
      "reads": {
        "stack": "string",
        "description": "string",
        "layers.T": "string",
        "layers.R": "string",
        "layers.A": "string",
        "layers.N": "string",
        "version": "string"
      }
    },
    {
      "name": "checkVoteEligibility",
      "method": "POST",
      "path": "/api/v1/vote/eligibility",
      "headers": {
        "X-Tran-Client": "web/0.1.0"
      },
      "body": {
        "age": 20
      },
      "status": 200,
      "reads": {
        "eligibility_id": "string",
        "eligible": "boolean",
        "age": "number",
