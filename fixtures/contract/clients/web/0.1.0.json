      "path": "/api/v1/auth/session",
      "headers": {
        "X-Tran-Client": "web/0.1.0"
      },
      "body": {
        "role": "citizen_voter",
        "transport": "cookie"
      },
      "status": 201,
      "reads": {
        "access_token": "string",
        "token_type": "string",
        "expires_in": "number",
        "user.user_id": "string",
        "user.role": "string"
      }
    },
    {
      "name": "refresh",
      "method": "POST",
      "path": "/api/v1/auth/refresh",
