        "X-Tran-Client": "web/0.1.0"
      },
      "status": 200,
      "reads": {
        "user_id": "string",
        "role": "string"
      }
    },
    {
      "name": "signOut",
      "method": "POST",
      "path": "/api/v1/auth/sign-out",
