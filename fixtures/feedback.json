    {
      "source": "server",
      "messageKey": "eligibility.result.sourceServer"
    },
    {
      "source": "device_fallback",
      "messageKey": "eligibility.result.sourceFallback"
    }
  ],
  "logEvent": {
    "message": "request failed",
    "fields": ["code", "status", "request_id", "trace_id"]
  },
  "requestCompletedLogEvent": {
    "message": "request completed",
    "fields": ["method", "route", "status", "latency_ms", "request_id", "trace_id"]
  },
