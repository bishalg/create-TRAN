{
  "$comment": "Golden error/feedback policy (REQ-ERR-*) shared by Rust (crates/rust-core/tests/feedback_fixtures.rs), TypeScript (packages/core-ts/tests/feedback.test.ts), iOS and Android parity tests. Change the policy here first (red), then in crates/rust-core/src/feedback.rs, then `pnpm tokens:sync`.",
  "toastDurationsMs": {
    "short": 3000,
    "medium": 5000,
    "long": 10000
  },
  "retryPolicy": {
    "maxAttempts": 3,
    "baseDelayMs": 200,
    "maxDelayMs": 2000,
    "requestTimeoutMs": 5000
  },
  "serverDeadlineMs": 4000,
  "loadingPolicy": {
    "indicatorDelayMs": 300,
    "pendingMessageKey": "eligibility.result.updating"
  },
