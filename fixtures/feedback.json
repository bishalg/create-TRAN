    {
      "header": "10",
      "expectedMs": 2000
    },
    {
      "header": "abc",
      "expectedMs": null
    },
    {
      "header": "",
      "expectedMs": null
    }
  ],
  "toastPolicy": {
    "maxVisible": 3
  },
  "toastQueue": [
    {
      "name": "empty queue appends",
      "visible": [],
      "incoming": ["errors.timeout", "error"],
      "expected": {
        "refresh": null,
        "evictOldest": 0
      }
    },
    {
      "name": "different message appends",
      "visible": [["errors.timeout", "error"]],
      "incoming": ["errors.rateLimited", "warning"],
      "expected": {
        "refresh": null,
        "evictOldest": 0
      }
    },
    {
      "name": "same key and tone refreshes in place",
      "visible": [
        ["errors.forbidden", "error"],
        ["errors.timeout", "error"]
      ],
      "incoming": ["errors.timeout", "error"],
      "expected": {
        "refresh": 1,
        "evictOldest": 0
      }
    },
    {
      "name": "same key, other tone is a different toast",
      "visible": [["errors.timeout", "error"]],
      "incoming": ["errors.timeout", "warning"],
      "expected": {
        "refresh": null,
        "evictOldest": 0
      }
    },
    {
      "name": "a fourth toast evicts the oldest",
      "visible": [
        ["a.one", "info"],
        ["a.two", "info"],
        ["a.three", "info"]
      ],
      "incoming": ["a.four", "info"],
      "expected": {
        "refresh": null,
        "evictOldest": 1
      }
    },
    {
      "name": "an overfull queue is trimmed to fit",
      "visible": [
        ["a.one", "info"],
        ["a.two", "info"],
        ["a.three", "info"],
        ["a.four", "info"]
      ],
      "incoming": ["a.five", "info"],
      "expected": {
        "refresh": null,
        "evictOldest": 2
      }
    },
    {
      "name": "a duplicate in a full queue refreshes, never evicts",
      "visible": [
        ["a.one", "info"],
        ["a.two", "info"],
        ["a.three", "info"]
      ],
      "incoming": ["a.one", "info"],
      "expected": {
        "refresh": 0,
        "evictOldest": 0
      }
    }
  ],
  "recoveryPolicy": {
