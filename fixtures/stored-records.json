{
  "$comment": "Stored-record versions and recovery decisions (spec 030, REQ-DB-011, REQ-DB-012, ADR-0049) shared by Rust (crates/rust-core/tests/stored_record_fixtures.rs), UniFFI (crates/tran-uniffi/tests/stored_record_fixtures.rs), TypeScript (packages/api/tests/stored-record.test.ts), iOS (StoredRecordTests.swift) and Android (StoredRecordTest.kt) parity tests. Every device record (session vault, push preferences, remote config) carries a schema version. `decisions`: the one Rust decision `stored_record(schema, current)` mapping versions to `use`, `upgrade`, or `discard`. `records`: kept records from past releases ensuring an app update keeps the person signed in and active.",
  "currentSchemas": {
    "session": 2,
    "push": 2,
    "config": 2
  },
  "decisions": [
    {
      "name": "matching version 1 uses record directly",
      "schema": 1,
      "current": 1,
      "action": "use"
    },
    {
      "name": "matching version 2 uses record directly",
      "schema": 2,
      "current": 2,
      "action": "use"
    },
    {
      "name": "older version 1 with current 2 upgrades record",
      "schema": 1,
      "current": 2,
      "action": "upgrade"
    },
    {
      "name": "older version 2 with current 3 upgrades record",
      "schema": 2,
      "current": 3,
      "action": "upgrade"
    },
    {
      "name": "newer version 3 with current 2 discards record",
      "schema": 3,
      "current": 2,
      "action": "discard"
    },
    {
      "name": "future version 99 with current 2 discards record",
      "schema": 99,
      "current": 2,
      "action": "discard"
    },
    {
      "name": "schema 0 with current 2 discards unversioned invalid record",
      "schema": 0,
      "current": 2,
      "action": "discard"
    },
    {
      "name": "current 0 discards record",
      "schema": 1,
      "current": 0,
      "action": "discard"
    }
  ],
