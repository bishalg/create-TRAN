{
  "$comment": "W3C Trace Context (spec 023, REQ-OBS-001) shared by Rust (crates/rust-core/tests/trace_fixtures.rs), UniFFI (crates/tran-uniffi/tests/trace_fixtures.rs), TypeScript (packages/api/tests/trace.test.ts), iOS (TraceParityTests.swift) and Android (TraceParityTest.kt). Change a rule here first (red), then crates/rust-core/src/trace.rs, then `pnpm tokens:sync`.",
  "parseValid": [
    {
      "name": "standard sampled trace",
      "header": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01",
      "expected": {
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "sampled": true
      }
    },
    {
      "name": "standard unsampled trace",
      "header": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00",
      "expected": {
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "sampled": false
      }
    },
    {
      "name": "sampled bit set with other flags",
      "header": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-03",
      "expected": {
        "traceId": "4bf92f3577b34da6a3ce929d0e0e4736",
        "spanId": "00f067aa0ba902b7",
        "sampled": true
      }
    },
    {
      "name": "all f hex values",
      "header": "00-ffffffffffffffffffffffffffffffff-ffffffffffffffff-01",
      "expected": {
        "traceId": "ffffffffffffffffffffffffffffffff",
        "spanId": "ffffffffffffffff",
        "sampled": true
      }
    }
  ],
