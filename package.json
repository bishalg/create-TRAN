{
  "name": "create-tran-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Vite + React web + Rust Core + Axum + Native iOS/Android in an Nx mono-repo template",
  "type": "module",
  "scripts": {
    "dev": "nx run-many -t dev",
    "dev:web": "nx run web:dev",
    "dev:api": "nx run api:dev",
    "build": "nx run-many -t build",
    "test": "pnpm run test:rust && pnpm run test:ts",
    "test:rust": "cargo test",
    "test:ts": "pnpm run build:libs && vitest run",
    "typecheck": "nx run-many -t typecheck",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && pnpm --filter web lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "tokens:sync": "cargo run -p tran-tokens-codegen",
    "i18n:sync": "cargo run -p tran-tokens-codegen",
    "uniffi:generate": "bash scripts/uniffi-generate.sh",
    "ios:project": "xcodegen generate --spec apps/ios/project.yml --project apps/ios",
    "ios:build": "xcodebuild -project apps/ios/TranVotingDemo.xcodeproj -scheme TranVotingDemo -destination 'generic/platform=iOS Simulator' build CODE_SIGNING_ALLOWED=NO",
    "android:build": "cd apps/android && ./gradlew assembleDebug",
    "ios:test": "xcodebuild test -project apps/ios/TranVotingDemo.xcodeproj -scheme TranVotingDemo -destination \"platform=iOS Simulator,name=$(xcrun simctl list devices available | grep -m1 -oE 'iPhone [A-Za-z0-9 ]+' | sed 's/ *$//')\" CODE_SIGNING_ALLOWED=NO",
    "android:test": "cd apps/android && ./gradlew testDebugUnitTest connectedDebugAndroidTest",
    "android:screenshots": "bash apps/android/scripts/screenshots.sh",
    "ios:screenshots": "bash apps/ios/scripts/screenshots.sh",
    "ios:screenshots:record": "bash apps/ios/scripts/screenshots.sh --record",
    "android:screenshots:record": "bash apps/android/scripts/screenshots.sh --record",
    "build:libs": "pnpm --filter @tran/api build && pnpm --filter @tran/core build",
    "test:coverage": "pnpm run test:rust:coverage && pnpm run test:ts:coverage",
    "test:ts:coverage": "pnpm run build:libs && vitest run --coverage",
    "test:rust:coverage": "cargo llvm-cov --workspace --ignore-filename-regex 'main.rs|tran-uniffi' --fail-under-lines 100 --fail-under-regions 100",
    "test:e2e": "pnpm --filter e2e test",
    "e2e:maestro": "maestro test e2e/maestro",
    "smoke": "bash scripts/smoke.sh",
    "metrics": "node --test tooling/metrics/metrics.test.mjs && node tooling/metrics/metrics.mjs",
    "visual": "pnpm --filter e2e visual",
    "visual:update": "pnpm --filter e2e visual:update",
    "spec:check": "node --test tooling/spec-check/spec-check.test.mjs && node tooling/spec-check/spec-check.mjs",
    "agents": "node tooling/agents/agents.mjs",
    "agents:check": "node --test tooling/agents/*.test.mjs && node tooling/agents/agents.mjs check",
    "supply:check": "node --test tooling/supply-chain/supply-chain.test.mjs && node tooling/supply-chain/supply-chain.mjs",
    "deps:audit": "pnpm audit --audit-level high && cargo audit --deny warnings",
    "release": "node tooling/release/release.mjs bump",
    "release:check": "node --test tooling/release/release.test.mjs && node tooling/release/release.mjs check",
    "tooling:test": "node --test tooling/entrypoints.test.mjs tooling/file-size.test.mjs",
    "test:all": "pnpm run lint && pnpm run test:coverage && pnpm run test:e2e",
    "check:quick": "pnpm spec:check && pnpm agents:check && pnpm supply:check && pnpm release:check && pnpm tooling:test && pnpm format:check && pnpm typecheck && pnpm lint",
    "hooks:install": "git config core.hooksPath .githooks && echo '\u2713 Git hooks installed (.githooks)'",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "nx": "^23.3.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
