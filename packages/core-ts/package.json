{
  "name": "@tran/core",
  "version": "0.1.0",
  "description": "Shared TypeScript SDK, models, i18n dictionaries, and Liquid Glass tokens for TRAN stack",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens.js",
      "types": "./dist/tokens.d.ts"
    },
    "./locales/*": "./src/locales/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@tran/api": "workspace:*"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "fast-check": "^4.10.2",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
